---
layout: default
---

<div class="home-hub-page">
  <header class="home-hub-header page-hero">
    <h1 class="home-hub-title page-hero-title">{{ page.title }}</h1>
    {% if page.subtitle %}
      <p class="home-hub-subtitle page-hero-subtitle">{{ page.subtitle }}</p>
    {% endif %}
  </header>

  <div class="row home-hub-row">
    <div class="col-lg-8 col-md-7 order-2 order-md-1">
      {% if content and content != "" %}
        <section class="home-section home-intro-section">
          <div class="home-intro-copy">
            {{ content }}
          </div>
        </section>
      {% endif %}

      <section class="home-section home-feature-section">
        <div class="home-feature-panels">
          <div class="home-feature-panel">
            <h2 class="home-section-title">
              <a href="{{ '/projects/' | relative_url }}">featured projects</a>
            </h2>

            {% assign featured_project_limit = page.featured_project_limit | default: 2 %}
            {% assign featured_projects = site.projects | where: "featured", true | sort: "importance" %}
            <div class="home-projects-grid home-feature-card-grid">
              {% for project in featured_projects limit: featured_project_limit %}
                <div class="home-project-card">
                  <div class="card h-100 hoverable project-card home-feature-card">
                    {% if project.img %}
                      <a href="{{ project.url | relative_url }}" class="card-media">
                        <img src="{{ project.img | relative_url }}" class="card-img-top" alt="{{ project.title }}">
                      </a>
                    {% endif %}
                    <div class="card-body">
                      <h5 class="card-title">
                        <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
                      </h5>
                      {% if project.description %}
                        <p class="card-text">{{ project.description }}</p>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>

          <div class="home-feature-panel">
            <h2 class="home-section-title">
              <a href="{{ '/art/' | relative_url }}">featured art</a>
            </h2>

            {% assign featured_art_limit = page.featured_art_limit | default: 2 %}
            {% assign featured_art = site.art | where: "featured", true | sort: "importance" %}
            <div class="home-projects-grid home-feature-card-grid">
              {% for piece in featured_art limit: featured_art_limit %}
                <div class="home-project-card">
                  <div class="card h-100 hoverable project-card home-feature-card">
                    {% if piece.image %}
                      <a href="{{ piece.url | relative_url }}" class="card-media">
                        <img src="{{ piece.image | relative_url }}" class="card-img-top" alt="{{ piece.title }}">
                      </a>
                    {% endif %}
                    <div class="card-body">
                      <h5 class="card-title">
                        <a href="{{ piece.url | relative_url }}">{{ piece.title }}</a>
                      </h5>
                      {% if piece.medium or piece.year %}
                        <p class="card-text home-art-meta">
                          {% if piece.medium %}{{ piece.medium }}{% endif %}{% if piece.medium and piece.year %}, {% endif %}{% if piece.year %}{{ piece.year }}{% endif %}
                        </p>
                      {% elsif piece.description %}
                        <p class="card-text">{{ piece.description }}</p>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </section>

      <section class="home-section">
        <h2 class="home-section-title">latest posts</h2>

        {% assign latest_writings_count = 0 %}
        {% include writing_posts.liquid %}
        {% assign latest_writing_posts = writing_posts %}
        {% for post in latest_writing_posts %}
            <div class="card mb-3 hoverable home-writing-card{% unless post.thumbnail %} home-writing-card--no-thumb{% endunless %}">
              {% if post.thumbnail %}
                <a class="home-writing-thumb" href="{{ post.url | relative_url }}">
                  <img src="{{ post.thumbnail | relative_url }}" alt="{{ post.title }}">
                </a>
              {% endif %}
              <div class="card-body home-writing-body">
                <h5 class="card-title mb-1">
                  <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
                </h5>
                {% if post.description %}
                  <p class="card-text mb-2">{{ post.description }}</p>
                {% endif %}
                <small class="text-muted">{{ post.date | date: "%B %-d, %Y" }}</small>
              </div>
            </div>
            {% assign latest_writings_count = latest_writings_count | plus: 1 %}
            {% if latest_writings_count >= 3 %}
              {% break %}
            {% endif %}
        {% endfor %}
      </section>
    </div>

    <div class="col-lg-4 col-md-5 order-1 order-md-2">
      <aside class="home-sidebar">
        {% if page.profile and page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% include figure.liquid
            loading="eager"
            path=profile_image_path
            class="img-fluid rounded z-depth-1 home-profile-img"
            alt=page.title
            cache_bust=true
          %}
        {% endif %}

        {% if page.short_bio %}
          <p class="home-blurb">{{ page.short_bio }}</p>
        {% endif %}

        {% if page.home_buttons %}
          <div class="home-buttons">
            {% for button in page.home_buttons %}
              {% assign button_href = button.url | strip %}

              {% unless button_href contains '://' or button_href contains '#' or button_href contains 'mailto:' or button_href contains 'tel:' %}
                {% assign resolved_button_doc = nil %}

                {% if button_href contains '.md' or button_href contains '.html' %}
                  {% assign resolved_button_doc = site.pages | where: "path", button_href | first %}

                  {% if resolved_button_doc == nil %}
                    {% assign resolved_button_doc = site.posts | where: "path", button_href | first %}
                  {% endif %}

                  {% if resolved_button_doc == nil %}
                    {% for collection in site.collections %}
                      {% assign collection_match = collection.docs | where: "path", button_href | first %}
                      {% if collection_match %}
                        {% assign resolved_button_doc = collection_match %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}

                  {% if resolved_button_doc %}
                    {% assign button_href = resolved_button_doc.url %}
                  {% endif %}
                {% endif %}

                {% assign button_href_prefix = button_href | slice: 0, 1 %}
                {% unless button_href_prefix == '/' %}
                  {% assign button_href = button_href | prepend: '/' %}
                {% endunless %}
              {% endunless %}

              <a class="home-button" href="{{ button_href | relative_url }}">{{ button.label }}</a>
            {% endfor %}
          </div>
        {% endif %}

        {% if page.announcements and page.announcements.enabled %}
            <section class="home-section mb-5">
                <h2 class="home-section-title">
                <a href="{{ '/news/' | relative_url }}" style="color: inherit;">news</a>
                </h2>
                {% include news.liquid limit=true %}
            </section>
        {% endif %}
        
      </aside>
    </div>
  </div>

  {% if page.social %}
    <div class="home-social">
      <div class="contact-icons">{% include social.liquid %}</div>
      <div class="contact-note">{{ site.contact_note }}</div>
    </div>
  {% endif %}
</div>
